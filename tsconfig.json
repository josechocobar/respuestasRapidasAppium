{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "types": ["node", "@wdio/globals/types"]
  },
  "include": ["tests", "shared", "wdio.conf.ts"],
  "exclude": ["node_modules", "dist"]
}
